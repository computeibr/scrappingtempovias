# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere uma string aleatória forte, ex: openssl rand -hex 32
SECRET=troque_por_uma_string_secreta_forte

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB=tempovias
DB_USER=tempovias_user
DB_PASS=troque_pela_sua_senha
DB_HOST=postgres   # nome do serviço no docker-compose (não alterar em produção)
DB_PORT=5432
DB_SSL=false       # mude para true se usar banco externo com SSL (ex: Supabase, Neon)

# ─── ETL / Scraping ───────────────────────────────────────────────────────────
# true  = ativa o Puppeteer e o cron de coleta (ambiente local)
# false = apenas API + frontend, sem scraping (Docker/EasyPanel)
ETL_ENABLED=true

# Número de abas paralelas do Puppeteer — ajuste conforme recursos da máquina:
#   2 vCPU /  8 GB → 8
#   4 vCPU / 16 GB → 15
ETL_CONCURRENCY=8

# ─── Alertas por e-mail (opcional) ───────────────────────────────────────────
# Requer conta Gmail com senha de aplicativo (Google Account > Segurança > Senhas de app)
# Deixar em branco para desativar alertas.
ALERT_EMAIL=seu@gmail.com
ALERT_EMAIL_PASS=senha_de_app_16_caracteres
ALERT_EMAIL_TO=destinatario@email.com   # se vazio, usa o próprio ALERT_EMAIL

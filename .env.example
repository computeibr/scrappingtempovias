# ══════════════════════════════════════════════════════════════════════════════
# TEMPOVIAS — Variáveis de ambiente
#
# DOIS AMBIENTES, UM BANCO:
#
#  [Máquina local — PM2]          [VPS — Docker/EasyPanel]
#   ETL_ENABLED=true               ETL_ENABLED=false (setado no EasyPanel)
#   Puppeteer coleta Google Maps   Só API + Frontend
#   Salva no PostgreSQL da VPS     Lê o mesmo PostgreSQL
#
# Este arquivo é o modelo para a máquina LOCAL (com ETL ativo).
# Na VPS, as variáveis são configuradas diretamente no painel do EasyPanel.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere uma string aleatória forte, ex: openssl rand -hex 32
SECRET=troque_por_uma_string_secreta_forte

# ─── PostgreSQL (banco na VPS — acessado remotamente pelo ambiente local) ────
DB=tempovias
DB_USER=tempovias_user
DB_PASS=troque_pela_sua_senha
DB_HOST=ip_ou_host_da_vps   # ex: 123.45.67.89 ou db.meudominio.com
DB_PORT=5432
DB_SSL=false                # true se o banco exigir SSL (ex: Supabase, Neon)

# ─── ETL / Scraping (ambiente LOCAL — PM2) ───────────────────────────────────
# Na VPS/Docker, ETL_ENABLED deve ser false (configurado no EasyPanel).
ETL_ENABLED=true

# Número de abas Puppeteer paralelas — ajuste conforme recursos da máquina:
#   2 vCPU /  8 GB → 4–6
#   4 vCPU / 16 GB → 8–12
#   8 vCPU / 32 GB → 15–20 (produção VPS, se ETL rodar lá)
ETL_CONCURRENCY=8

# true = domcontentloaded + 3s (mais rápido, padrão recomendado)
# false = networkidle2 (mais lento, mais preciso em conexões lentas)
ETL_FAST_MODE=true

# Modo failover:
#   false (padrão) = máquina PRIMÁRIA — sempre roda o ETL e grava o heartbeat no banco
#   true           = máquina BACKUP (VPS) — só roda se a primária não gravar heartbeat
#                    há mais de ETL_FAILOVER_MINUTOS minutos
ETL_FAILOVER=false
ETL_FAILOVER_MINUTOS=10

# Delay em ms entre abertura de cada aba (500ms é seguro com request interception)
ETL_TAB_DELAY=500

# Ciclos antes de reciclar o browser Chromium (padrão 12 ≈ 1h com cron de 5min)
ETL_BROWSER_RECYCLE=12

# ─── Alertas por e-mail (opcional) ───────────────────────────────────────────
# Requer conta Gmail com senha de aplicativo (não a senha normal):
#   Conta Google → Segurança → Senhas de apps → gerar senha de 16 caracteres
# Deixar em branco para desativar alertas.
ALERT_EMAIL=seu@gmail.com
ALERT_EMAIL_PASS=senha_de_app_16_caracteres
ALERT_EMAIL_TO=destinatario@email.com   # se vazio, usa o próprio ALERT_EMAIL

# CPU % da VPS acima deste threshold dispara alerta por e-mail (padrão: 80)
ALERTA_CPU_PORCENTO=80

# ─── Alertas de variação via WhatsApp ────────────────────────────────────────
# Integração com CRM API (mesma usada no Yeastar)
# Deixar CRM_API_URL em branco para desativar alertas WhatsApp.
CRM_API_URL=https://integracao.agendasistemacrm.com.br/api/v1
CRM_API_KEY=<bearer token da CRM API>
CRM_WHATSAPP_ID=<id do número WhatsApp na CRM — ex: 17343>

# Números que receberão o alerta (separados por vírgula, com DDI 55)
# Ex: 5521999999999,5521888888888
ALERTA_WHATSAPP_PARA=

# Variação % mínima para disparar alerta (padrão: 20 = +20% acima da média)
ALERTA_VARIACAO_PORCENTO=20

# Cooldown em minutos entre alertas para a mesma rota (padrão: 60)
ALERTA_VARIACAO_COOLDOWN=60
